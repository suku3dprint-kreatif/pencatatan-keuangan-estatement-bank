# Wajib kalau mau pakai AI analyzer (prediksi merchant + kategori QRIS).
# Ambil di https://console.anthropic.com/settings/keys
# Tanpa key ini tools tetap jalan, tapi cuma pakai mesin rule-based/kamus merchant.
ANTHROPIC_API_KEY=

# Opsional. Default: claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5

# Opsional. Level effort AI: low | medium | high | xhigh | max (default: medium)
# ANTHROPIC_EFFORT=medium

# Opsional. Batas ukuran upload per file dalam MB (default: 4).
# Default-nya mengikuti batas request body platform serverless seperti Vercel
# (~4,5 MB). Kalau di-deploy sendiri tanpa batas itu, boleh dinaikkan.
# MAX_UPLOAD_MB=25
